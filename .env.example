# Local Ethereum is the default. Use 11155111 for Ethereum Sepolia, then rebuild.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Local mode reads deployments/local.json when this is empty.
NEXT_PUBLIC_CONSENTCRAFT_ADDRESS=
EVM_RPC_URL=http://127.0.0.1:8545

# Optional for injected wallets; enables WalletConnect when configured.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Required for Sepolia review packages; local mode works without it.
PINATA_JWT=

# Deploy with SEPOLIA_RPC_URL and DEPLOYER_PRIVATE_KEY in the deployment shell.
# Never put deployer keys in this web app's env files or browser configuration.
